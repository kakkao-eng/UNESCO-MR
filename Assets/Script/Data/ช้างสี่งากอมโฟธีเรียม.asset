  fossilNameTH: "\u0E0A\u0E49\u0E32\u0E07\u0E2A\u0E35\u0E48\u0E07\u0E32\u0E01\u0E2D\u0E21\u0E42\u0E1F\u0E18\u0E35\u0E40\u0E23\u0E35\u0E22\u0E21"
  fossilNameEN: Gomphotherium
  fossilImage: {fileID: 21300000, guid: 86a76d72152d64bf18aa712f124ad1a1, type: 3}
  fossilDescription: "\u0E25\u0E31\u0E01\u0E29\u0E13\u0E30\u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B:
    \u0E08\u0E31\u0E14\u0E2D\u0E22\u0E39\u0E48\u0E43\u0E19\u0E01\u0E25\u0E38\u0E48\u0E21\u0E0A\u0E49\u0E32\u0E07\u0E2A\u0E35\u0E48\u0E07\u0E32
    \u0E21\u0E35\u0E07\u0E322\u0E04\u0E39\u0E48 \u0E42\u0E14\u0E22\u0E04\u0E39\u0E48\u0E1A\u0E19\u0E42\u0E04\u0E49\u0E07\u0E25\u0E07\u0E04\u0E23\u0E48\u0E2D\u0E21\u0E04\u0E39\u0E48\u0E25\u0E48\u0E32\u0E07
    \u0E2A\u0E39\u0E07\u0E1B\u0E23\u0E30\u0E21\u0E32\u0E13 2.5 \u0E40\u0E21\u0E15\u0E23\n\u0E2D\u0E32\u0E22\u0E38:
    \u0E44\u0E21\u0E42\u0E2D\u0E0B\u0E35\u0E19\u0E15\u0E2D\u0E19\u0E01\u0E25\u0E32\u0E07(Middle
    Miocene) \u0E1B\u0E23\u0E30\u0E21\u0E32\u0E13 16-11 \u0E25\u0E49\u0E32\u0E19\u0E1B\u0E35\u0E01\u0E48\u0E2D\u0E19\n\u0E41\u0E2B\u0E25\u0E48\u0E07\u0E17\u0E35\u0E48\u0E1E\u0E1A:
    \u0E2D\u0E33\u0E40\u0E20\u0E2D\u0E41\u0E21\u0E48\u0E40\u0E21\u0E32\u0E30 \u0E08\u0E31\u0E07\u0E2B\u0E27\u0E31\u0E14\u0E25\u0E33\u0E1B\u0E32\u0E07\u0E33\u0E32\u0E40\u0E20\u0E2D\u0E40\u0E09\u0E25\u0E34\u0E21\u0E1E\u0E23\u0E30\u0E40\u0E01\u0E35\u0E22\u0E23\u0E15\u0E34
    \u0E08\u0E31\u0E07\u0E2B\u0E27\u0E31\u0E14\u0E19\u0E04\u0E23\u0E23\u0E32\u0E0A\u0E2A\u0E35\u0E21\u0E32\n\u0E27\u0E07\u0E2A\u0E4C:
