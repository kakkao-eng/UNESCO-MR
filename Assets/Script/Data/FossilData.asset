  fossilNames:
  - "\u0E0A\u0E49\u0E32\u0E07\u0E2A\u0E35\u0E48\u0E07\u0E32\u0E01\u0E2D\u0E21\u0E42\u0E1F\u0E18\u0E35\u0E40\u0E23\u0E35\u0E22\u0E21"
  - "\u0E0A\u0E49\u0E32\u0E07\u0E07\u0E32\u0E08\u0E2D\u0E1A\u0E42\u0E1B\u0E23\u0E44\u0E14\u0E42\u0E19\u0E18\u0E35\u0E40\u0E23\u0E35\u0E22\u0E21"
  - "\u0E0A\u0E49\u0E32\u0E07\u0E07\u0E32\u0E40\u0E2A\u0E35\u0E22\u0E21\u0E42\u0E1B\u0E23\u0E15\u0E32\u0E19\u0E31\u0E19\u0E04\u0E31\u0E2A"
  - "\u0E0A\u0E49\u0E32\u0E07\u0E40\u0E15\u0E15\u0E23\u0E30\u0E42\u0E25\u0E42\u0E1F\u0E14\u0E2D\u0E19"
  - "\u0E0A\u0E49\u0E32\u0E07\u0E2A\u0E40\u0E15\u0E42\u0E01\u0E42\u0E25\u0E42\u0E1F\u0E14\u0E2D\u0E19"
  - "\u0E0A\u0E49\u0E32\u0E07\u0E44\u0E0B\u0E42\u0E19\u0E21\u0E32\u0E2A\u0E42\u0E15\u0E14\u0E2D\u0E19"
  - "\u0E0A\u0E49\u0E32\u0E07\u0E2A\u0E40\u0E15\u0E42\u0E01\u0E14\u0E2D\u0E19"
  - "\u0E0A\u0E49\u0E32\u0E07\u0E40\u0E2D\u0E25\u0E34\u0E1F\u0E32\u0E2A"
  - "\u0E15\u0E49\u0E19\u0E21\u0E30\u0E04\u0E48\u0E32\u0E42\u0E21\u0E07\u0E01\u0E25\u0E32\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E2B\u0E34\u0E19"
  - "\u0E15\u0E49\u0E19\u0E1B\u0E32\u0E25\u0E4C\u0E21\u0E01\u0E25\u0E32\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E2B\u0E34\u0E19"
